# ==========================================
# Shop Billing Application - Supabase & DB Configuration
# ==========================================

# 1. Supabase PostgreSQL Connection String
# Replace [YOUR-PASSWORD] and [PROJECT-REF] with your Supabase credentials:
# Example Direct: postgresql://postgres:[YOUR-PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres
# Example Pooled: postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres
# Note: If left empty, application will safely fall back to local SQLite for local testing.
DATABASE_URL=

# 2. Supabase Storage Configuration (Private Bucket for Authorized Seal)
# Found in Supabase Dashboard -> Project Settings -> API
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=shop-assets

# 3. Application Settings
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173
PORT=8000
